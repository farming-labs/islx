{
  "name": "@farm.js/islx",
  "version": "0.0.3",
  "description": "A renderer-agnostic wire format for server-rendered islands: typed props, values sent once, server actions, and partial navigations.",
  "keywords": [
    "islands",
    "server-components",
    "server-actions",
    "ssr",
    "hydration",
    "react",
    "vite"
  ],
  "license": "MIT",
  "author": "Farming Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farming-labs/islx.git"
  },
  "homepage": "https://github.com/farming-labs/islx#readme",
  "type": "module",
  "sideEffects": [
    "./dist/react/server.mjs"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "dist",
    "SPEC.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "default": "./dist/client.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    },
    "./compiler": {
      "types": "./dist/compiler.d.mts",
      "default": "./dist/compiler.mjs"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "default": "./dist/react.mjs"
    },
    "./react/server": {
      "types": "./dist/react/server.d.mts",
      "default": "./dist/react/server.mjs"
    },
    "./react/client": {
      "types": "./dist/react/client.d.mts",
      "default": "./dist/react/client.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "format": "oxfmt src test",
    "format:check": "oxfmt --check src test",
    "prepublishOnly": "pnpm build",
    "test:e2e": "playwright test",
    "release:check": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && npm pack --dry-run"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/estree": "^1.0.10",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "25.0.1",
    "oxc-parser": "0.156.0",
    "oxfmt": "0.27.0",
    "oxlint": "1.42.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsdown": "0.15.7",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "3.2.7"
  },
  "packageManager": "pnpm@10.9.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "estree-walker": "3.0.3",
    "is-reference": "3.0.3",
    "magic-string": "0.30.21",
    "periscopic": "4.0.3"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
