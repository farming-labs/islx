{
  "name": "furrow",
  "version": "0.0.0",
  "description": "A renderer-agnostic wire format for server-rendered islands: typed props, values sent once, server actions, and partial navigations.",
  "keywords": [
    "islands",
    "server-components",
    "server-actions",
    "ssr",
    "hydration",
    "react",
    "vite"
  ],
  "license": "MIT",
  "author": "Farming Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farming-labs/furrow.git"
  },
  "homepage": "https://github.com/farming-labs/furrow#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "dist",
    "SPEC.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "default": "./dist/client.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "format": "oxfmt src test",
    "format:check": "oxfmt --check src test",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "jsdom": "25.0.1",
    "oxfmt": "0.27.0",
    "oxlint": "1.42.0",
    "tsdown": "0.15.7",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "packageManager": "pnpm@10.9.0"
}
